# syntax=docker/dockerfile:1
# Baseline for scripts/bench.sh: OpenSSL as shipped by a current stable enterprise distribution.
# Image pinned by digest (debian:trixie, resolved 2026-11-17). The openssl package is whatever trixie
# currently ships (3.5.7-1~deb13u3 on 2026-11-17); bench.sh records the exact version in its output.
FROM debian:trixie@sha256:9c6e381421d0f48d1b8133e573f33c185ee16cbf505eda9c4a8a4791b25ea8a6
RUN apt-get update \
 && apt-get install -y --no-install-recommends openssl \
 && rm -rf /var/lib/apt/lists/*
LABEL org.opencontainers.image.title="pqc-hsm-lab-baseline" \
      org.opencontainers.image.description="Debian trixie OpenSSL 3.5 baseline for the pqc-hsm-lab speed comparison"
